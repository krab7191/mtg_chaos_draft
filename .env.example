# Google OAuth2 — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost/api/auth/callback

# Your Google account email — gets admin role on first login
ADMIN_EMAIL=

# Comma-separated emails that get viewer role (optional)
VIEWER_EMAILS=

# Caddy domain (localhost for dev, your domain in prod)
DOMAIN=localhost

# Local dev (`make dev`) overrides GOOGLE_REDIRECT_URL with this so login
# returns to the Astro dev server instead of the live site. Add it as an
# authorized redirect URI on the Google OAuth client.
DEV_GOOGLE_REDIRECT_URL=http://localhost:4321/api/auth/callback
