{
  "name": "mtg-chaos-draft-frontend",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.svelte-check.json",
    "test": "vitest run --coverage && node -e \"const s=JSON.parse(require('fs').readFileSync('./coverage/coverage-summary.json','utf8'));console.log('Coverage: '+s.total.statements.pct+'%')\""
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/node": "^11.1.11",
    "@astrojs/svelte": "^9.1.4",
    "astro": "^7.4.9",
    "sass": "^1.108.1",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
