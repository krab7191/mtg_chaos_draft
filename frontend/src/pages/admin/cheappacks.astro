---
import Layout from '../../layouts/Layout.astro';
import StoreDeals from '../../components/deals/StoreDeals.svelte';
import CheapestPacks from '../../components/deals/CheapestPacks.svelte';
import PackCheck from '../../components/deals/PackCheck.svelte';

const apiUrl = import.meta.env.API_URL ?? 'http://api:8080';
const cookie = Astro.request.headers.get('cookie') ?? '';

let meRes: Response;
try {
  meRes = await fetch(`${apiUrl}/api/auth/me`, { headers: { cookie } });
} catch {
  return Astro.redirect('/login');
}
if (!meRes.ok) return Astro.redirect('/login');
const user = await meRes.json();
const ADMIN_ROLES = ['admin', 'viewer'];
if (!ADMIN_ROLES.includes(user.role)) return Astro.redirect('/select');

// Defaults to sets released before 2020; an empty value ("Clear") shows every set.
const DEFAULT_BEFORE = '2020-01-01';
const before = Astro.url.searchParams.get('before') ?? DEFAULT_BEFORE;
---

<Layout title="Cheap Packs" user={user} wide>
  <div class="page">
    <h1 class="page__title">Cheap Packs</h1>
    <p class="page__sub">Packs for chaos drafts: store deals on single packs, and the cheapest packs by market price.</p>

    <PackCheck client:load />

    <StoreDeals client:load canEdit={user.role === 'admin'} />

    <CheapestPacks client:load before={before} canEdit={user.role === 'admin'} />
  </div>
</Layout>

<style>
  .page {
    &__title { font-size: 1.4rem; margin-bottom: 0.3rem; }
    &__sub   { color: var(--color-text-muted); margin-bottom: 1.5rem; font-size: 0.9rem; }
  }
</style>
